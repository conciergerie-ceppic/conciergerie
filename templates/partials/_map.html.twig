<div id="map" class="invisible h-[80rem] w-[40rem]  lg:w-[20rem] fixed rounded-md bottom-0 right-0 mr-5 mb-20 opacity-90 z-50"></div>
{% if app.request.attributes.get('_route') != 'app_register' and app.request.attributes.get('_route') != 'app_login' %}
    <button id="toogleMap" class="px-6 py-5 md:text-lg lg:text-sm lg:px-3 lg:py-2 bg-white rounded-md fixed bottom-20 shadow-md w-[20rem] right-5 z-50 cursor-pointer" onclick="toogleMap()">
        Afficher/Masquer la carte
    </button>
{% endif %}
<script>
    const toogleMap = ()=> {
        const map = document.getElementById("map");
        if (map.classList.contains("invisible")) {
            map.classList.remove("invisible");
        } else {
            map.classList.add("invisible");
        }
    }
</script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const lat = "{{ userLat }}";
        const lon = "{{ userLon }}";
        const ville = "{{ app.session.get('ville')|e('js') }}";

        const map = L.map('map').setView([lat, lon], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors',
            maxZoom: 19
        }).addTo(map);

        L.marker([lat, lon]).addTo(map)
            .bindPopup(ville ? ville : 'Vous êtes ici')
            .openPopup();
    });
</script>