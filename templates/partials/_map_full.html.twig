<div id="mapfull" class="h-[40vh] w-full rounded-md mt-10 z-30"></div>

<script>
if (!window.mapFull) {

    const lat = parseFloat("{{ app.session.get('lat') }}");
    const lon = parseFloat("{{ app.session.get('lon') }}");
    const ville = "{{ app.session.get('ville')|e('js') }}";

    window.mapFull = L.map('mapfull', { scrollWheelZoom: false }).setView([lat, lon], 13);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors',
        maxZoom: 19
    }).addTo(window.mapFull);

    L.marker([lat, lon])
        .addTo(window.mapFull)
        .bindPopup(ville || "Vous êtes ici")
        .openPopup();

    window.mapFullReady = true;
    document.dispatchEvent(new Event('mapReady'));
}
</script>