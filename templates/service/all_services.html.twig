{% extends 'base.html.twig' %}

{% block title %}Tous les services{% endblock %}

{% block body %}
<div class="min-h-screen pt-52 pb-20 px-6 max-w-4xl mx-auto">

    <div class="mb-12 text-center">
        <p class="text-xs tracking-[0.4em] text-black/40 uppercase mb-2">Résultats de recherche</p>
        <h1 class="text-6xl uppercase tracking-widest text-black drop-shadow-[0_1px_1px_black] mb-4">
            All Services
        </h1>
        <div class="h-px w-32 mx-auto bg-gradient-to-r from-black via-black/40 to-transparent"></div>
    </div>

    {% if partners is empty %}
    <p class="text-center text-black/40 tracking-widest text-sm uppercase mt-20">
        Aucun établissement trouvé.
    </p>
    {% else %}

    {% set hasDistances = distances is not empty %}

    {# Récupère les IDs des partenaires favoris de l'utilisateur connecté #}
    {% set favoriteIds = [] %}
    {% if app.user %}
    {% for fav in app.user.userFavoritePartners %}
    {% set favoriteIds = favoriteIds|merge([fav.partnerId.id]) %}
    {% endfor %}
    {% endif %}

    {% if hasDistances %}
    <div class="mb-8 flex flex-wrap justify-center gap-3">
        <button onclick="filterByDistance('all')" id="filter-all"
            class="filter-btn px-5 py-2 rounded-lg text-xs tracking-[0.3em] uppercase border border-black/30 text-black bg-black/20 hover:bg-black/30 transition-colors duration-300">
            Tous
        </button>
        <button onclick="filterByDistance(0, 5)" id="filter-0-5"
            class="filter-btn px-5 py-2 rounded-lg text-xs tracking-[0.3em] uppercase border border-black/10 text-black/60 bg-black/5 hover:bg-black/20 hover:text-black transition-colors duration-300">
            0 – 5 km
        </button>
        <button onclick="filterByDistance(5, 10)" id="filter-5-10"
            class="filter-btn px-5 py-2 rounded-lg text-xs tracking-[0.3em] uppercase border border-black/10 text-black/60 bg-black/5 hover:bg-black/20 hover:text-black transition-colors duration-300">
            5 – 10 km
        </button>
        <button onclick="filterByDistance(10, 20)" id="filter-10-20"
            class="filter-btn px-5 py-2 rounded-lg text-xs tracking-[0.3em] uppercase border border-black/10 text-black/60 bg-black/5 hover:bg-black/20 hover:text-black transition-colors duration-300">
            10 – 20 km
        </button>
        <button onclick="filterByDistance(20, 50)" id="filter-20-50"
            class="filter-btn px-5 py-2 rounded-lg text-xs tracking-[0.3em] uppercase border border-black/10 text-black/60 bg-black/5 hover:bg-black/20 hover:text-black transition-colors duration-300">
            20 – 50 km
        </button>
        <button onclick="filterByDistance(50, 200)" id="filter-50-200"
            class="filter-btn px-5 py-2 rounded-lg text-xs tracking-[0.3em] uppercase border border-black/10 text-black/60 bg-black/5 hover:bg-black/20 hover:text-black transition-colors duration-300">
            50 – 200 km
        </button>
        <button onclick="filterByDistance(200, 99999)" id="filter-200-99999"
            class="filter-btn px-5 py-2 rounded-lg text-xs tracking-[0.3em] uppercase border border-black/10 text-black/60 bg-black/5 hover:bg-black/20 hover:text-black transition-colors duration-300">
            + 200 km
        </button>
    </div>
    {% else %}
    <div class="mb-8 text-center">
        <p class="text-black/30 text-xs tracking-[0.3em] uppercase flex items-center justify-center gap-2">
            <img src="/assets/img/icons/location.svg" alt="" class="invert size-3 opacity-30">
            Géolocalisation non disponible — distances non calculées
        </p>
    </div>
    {% endif %}

    <p id="no-results" class="hidden text-center text-black/40 tracking-widest text-sm uppercase mt-10">
        Aucun établissement dans cette tranche de distance.
    </p>

    <ul id="partners-list" class="space-y-4">
        {% for partner in partners %}
        {% set dist = distances[partner.id] ?? null %}
        {% set coords = partnerCoords[partner.id] ?? null %}
        {% set isFavorite = partner.id in favoriteIds %}

        <li class="partner-item group flex items-start gap-6 transition-colors duration-300 rounded-xl px-6 py-5 backdrop-blur-sm border border-black/10 cursor-pointer"
            style="background-color: #E8E8E8;" onmouseover="this.style.backgroundColor='#D4D4D4'"
            onmouseout="this.style.backgroundColor='#E8E8E8'" {% if coords %}
            onclick="focusPartner({{ coords.lat }}, {{ coords.lon }}, '{{ partner.name|e('js') }}', '{{ partner.address|e('js') }}')"
            {% endif %} data-distance="{{ dist ?? 99999 }}">

            <div class="text-4xl text-black/20 font-bold w-10 text-right shrink-0 select-none pt-1 item-index">
                {{ loop.index }}
            </div>

            <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-4 flex-wrap">
                    <div>
                        <h2 class="text-black uppercase tracking-widest text-sm font-bold mb-1">
                            {{ partner.name }}
                        </h2>
                        <p class="text-black/50 text-xs tracking-wider uppercase flex items-center gap-1">
                            <img src="/assets/img/icons/location.svg" alt="" class="invert size-3 opacity-50">
                            {{ partner.address }}
                        </p>
                    </div>

                    <div class="flex items-center gap-2 shrink-0">
                        {% if dist is not null %}
                        <div class="bg-black/10 rounded-lg px-3 py-1 text-center">
                            <span class="text-black text-lg font-light">
                                {{ dist|number_format(1, ',', ' ') }}
                            </span>
                            <span class="text-black/40 text-xs ml-1">km</span>
                        </div>
                        {% endif %}

                        {# Bouton favori (visible uniquement si connecté) #}
                        {% if app.user %}
                        <button onclick="event.stopPropagation(); toggleFavorite(this, {{ partner.id }})"
                            class="favorite-btn p-2 rounded-lg transition-colors duration-300 hover:bg-black/10"
                            data-partner-id="{{ partner.id }}"
                            title="{{ isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' }}">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                class="w-5 h-5 transition-colors duration-300 {{ isFavorite ? 'fill-yellow-500 text-yellow-500' : 'fill-none text-black/30' }}"
                                viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
                            </svg>
                        </button>
                        {% endif %}

                        {# Bouton partage WhatsApp #}
                        <a href="https://wa.me/?text={{ ('Découvrez ' ~ partner.name ~ ' : ' ~ partner.address ~ (partner.link ? ' - ' ~ partner.link : ''))|url_encode }}"
                            target="_blank" onclick="event.stopPropagation()"
                            class="p-2 rounded-lg transition-colors duration-300 hover:bg-black/10"
                            title="Partager sur WhatsApp">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-600" viewBox="0 0 24 24"
                                fill="currentColor">
                                <path
                                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
                            </svg>
                        </a>
                    </div>
                </div>

                {% if partner.description %}
                <p class="mt-3 text-black/40 text-xs leading-relaxed">
                    {{ partner.description|slice(0, 150) }}{% if partner.description|length > 150 %}…{% endif %}
                </p>
                {% endif %}

                {% if partner.phone %}
                <p class="mt-2 text-black/30 text-xs tracking-wider">
                    📞 {{ partner.phone }}
                </p>
                {% endif %}

                {% if partner.link %}
                <a href="{{ partner.link }}" target="_blank" onclick="event.stopPropagation()"
                    class="inline-block mt-3 text-[10px] tracking-[0.3em] uppercase text-black/60 hover:text-black transition-colors duration-300">
                    Voir l'établissement →
                </a>
                {% endif %}
            </div>
        </li>
        {% endfor %}
    </ul>

    {% endif %}
    {% include 'partials/_map_full.html.twig' %}
</div>

<script>
    function toggleFavorite(btn, partnerId) {
        fetch(`/favorite/toggle/${partnerId}`, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                const svg = btn.querySelector('svg');
                if (data.status === 'added') {
                    svg.classList.remove('fill-none', 'text-black/30');
                    svg.classList.add('fill-yellow-500', 'text-yellow-500');
                    btn.title = 'Retirer des favoris';
                } else {
                    svg.classList.remove('fill-yellow-500', 'text-yellow-500');
                    svg.classList.add('fill-none', 'text-black/30');
                    btn.title = 'Ajouter aux favoris';
                }
            });
    }

    function focusPartner(lat, lon, name, address) {
        const mapEl = document.getElementById('mapfull');
        if (!mapEl || typeof window.map === "undefined") return;

        mapEl.classList.remove('invisible');
        window.map.setView([lat, lon], 15);

        window.map.eachLayer(function (layer) {
            if (layer instanceof L.Marker) {
                const pos = layer.getLatLng();
                if (Math.abs(pos.lat - lat) < 0.0001 && Math.abs(pos.lng - lon) < 0.0001) {
                    layer.openPopup();
                }
            }
        });
    }

    function filterByDistance(min, max) {
        const items = document.querySelectorAll('.partner-item');
        const noResults = document.getElementById('no-results');
        let visibleCount = 0;

        items.forEach((item) => {
            const distance = parseFloat(item.dataset.distance);
            const visible = min === 'all' ? true : (distance >= min && distance < max);

            item.style.display = visible ? '' : 'none';
            if (visible) {
                visibleCount++;
                item.querySelector('.item-index').textContent = visibleCount;
            }
        });

        noResults.classList.toggle('hidden', visibleCount > 0);

        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.classList.remove('bg-black/20', 'border-black/30', 'text-black');
            btn.classList.add('bg-black/5', 'border-black/10', 'text-black/60');
        });

        const activeId = min === 'all' ? 'filter-all' : `filter-${min}-${max}`;
        const activeBtn = document.getElementById(activeId);
        if (activeBtn) {
            activeBtn.classList.add('bg-black/20', 'border-black/30', 'text-black');
            activeBtn.classList.remove('bg-black/5', 'border-black/10', 'text-black/60');
        }
    }
</script>

{% endblock %}

{% block map_markers %}
document.addEventListener('mapReady', function () {
{% for partner in partners %}
{% set coords = partnerCoords[partner.id] ?? null %}
{% if coords %}
L.marker([{{ coords.lat }}, {{ coords.lon }}])
.addTo(window.map)
.bindPopup(`<b>{{ partner.name|e('js') }}</b><br>{{ partner.address|e('js') }}`);
{% endif %}
{% endfor %}
});
{% endblock %}