{% extends 'base.html.twig' %}

{% block title %}{{ service.name }}{% endblock %}

{% block body %}

<h1 class="text-3xl font-bold text-center mt-6">{{ service.name }}</h1>

<div id="map" style="height:500px;margin-top:20px;"></div>

<link
rel="stylesheet"
href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>

const userLat = {{ userLat ?? 48.8566 }};
const userLon = {{ userLon ?? 2.3522 }};

const osmKey = "{{ osmKey }}";
const osmVal = "{{ osmVal }}";

let map;

/* évite l'erreur "map already initialized" */

if(!window.leafletMap){

    window.leafletMap = L.map('map').setView([userLat, userLon], 13);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution:'© OpenStreetMap'
    }).addTo(window.leafletMap);

}

map = window.leafletMap;

L.marker([userLat, userLon])
.addTo(map)
.bindPopup("Vous êtes ici")
.openPopup();

async function fetchWithTimeout(resource, options = {}) {

    const controller = new AbortController();
    const id = setTimeout(() => controller.abort(), 20000);

    const response = await fetch(resource, {
        ...options,
        signal: controller.signal
    });

    clearTimeout(id);

    if(!response.ok){
        throw new Error("HTTP " + response.status);
    }

    return response.json();
}

async function fetchOverpass(query){

    const url = "/api/overpass?query=" + encodeURIComponent(query);

    try{
        return await fetchWithTimeout(url);
    }
    catch(error){
        console.error("Erreur Overpass:", error);
        return null;
    }
}

async function loadPartners(){

    if(!osmKey || !osmVal){
        console.warn("Pas de tag OSM défini");
        return;
    }

    const query = `
    [out:json][timeout:40];
    (
        node[${osmKey}=${osmVal}](around:5000,${userLat},${userLon});
        way[${osmKey}=${osmVal}](around:5000,${userLat},${userLon});
        relation[${osmKey}=${osmVal}](around:5000,${userLat},${userLon});
    );
    out center 50;
    `;

    const data = await fetchOverpass(query);

    if(!data || !data.elements){
        alert("Impossible de charger les partenaires pour le moment.");
        return;
    }

    data.elements.forEach(el => {

        let lat = el.lat;
        let lon = el.lon;

        if(!lat && el.center){
            lat = el.center.lat;
            lon = el.center.lon;
        }

        if(!lat) return;

        const name = el.tags?.name ?? "Partenaire";

        L.marker([lat,lon])
        .addTo(map)
        .bindPopup(name);

    });

}

loadPartners();

</script>

{% endblock %}