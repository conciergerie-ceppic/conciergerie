{% extends 'base.html.twig' %}

{% block title %}Service - {{ service.name|capitalize }}{% endblock %}

{% block body %}
<div class="min-h-screen pt-52 pb-20 px-6 max-w-4xl mx-auto">

    <div class="mb-12 text-center">
        <p class="text-xs tracking-[0.4em] text-black/40 uppercase mb-2">Résultats de recherche</p>
        <h1 class="text-6xl uppercase tracking-widest text-black drop-shadow-[0_1px_1px_black] mb-4">
            {{ service.name|capitalize }}
        </h1>
        <div class="h-px w-32 mx-auto bg-gradient-to-r from-black via-black/40 to-transparent"></div>
    </div>

    {% if userLat and userLon and service.osmKey and service.osmVal %}
        <div class="mb-8 flex flex-wrap justify-center gap-3">
            <button onclick="filterByDistance('all')" id="filter-all" class="filter-btn px-5 py-2 rounded-lg text-xs tracking-[0.3em] uppercase border border-black/30 text-black bg-black/20 hover:bg-black/30 transition-colors duration-300">Tous</button>
            <button onclick="filterByDistance(0,5)" id="filter-0-5" class="filter-btn px-5 py-2 rounded-lg text-xs tracking-[0.3em] uppercase border border-black/10 text-black/60 bg-black/5 hover:bg-black/20 hover:text-black transition-colors duration-300">0 – 5 km</button>
            <button onclick="filterByDistance(5,10)" id="filter-5-10" class="filter-btn px-5 py-2 rounded-lg text-xs tracking-[0.3em] uppercase border border-black/10 text-black/60 bg-black/5 hover:bg-black/20 hover:text-black transition-colors duration-300">5 – 10 km</button>
        </div>

        <p id="loading" class="text-center text-black/40 tracking-widest text-sm uppercase mt-10">Chargement des établissements...</p>
        <p id="no-results" class="hidden text-center text-black/40 tracking-widest text-sm uppercase mt-10">Aucun établissement trouvé.</p>

        <ul id="partners-list" class="space-y-4 mt-6"></ul>

        {% include 'partials/_map_full.html.twig' %}

    {% else %}
        <p class="text-center text-black/40 tracking-widest text-sm uppercase mt-20">Géolocalisation ou informations du service non disponibles.</p>
    {% endif %}
</div>

<script>
const USER_LAT = {{ userLat ?? 'null' }};
const USER_LON = {{ userLon ?? 'null' }};
const OSM_KEY = "{{ service.osmKey }}";
const OSM_VAL = "{{ service.osmVal }}";

// Calcul de distance haversine
function haversine(lat1, lon1, lat2, lon2) {
    const R = 6371;
    const dLat = (lat2-lat1) * Math.PI / 180;
    const dLon = (lon2-lon1) * Math.PI / 180;
    const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180) * Math.cos(lat2*Math.PI/180) * Math.sin(dLon/2)**2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
}

// fetch avec timeout
async function fetchWithTimeout(url, timeoutMs=60000) {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), timeoutMs);
    try {
        const res = await fetch(url, { signal: controller.signal });
        clearTimeout(timeoutId);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        return await res.json();
    } catch(e) {
        clearTimeout(timeoutId);
        throw e;
    }
}

// cache sessionStorage
async function fetchOverpassCached(query) {
    const cacheKey = `overpass_${btoa(query)}`;
    const cached = sessionStorage.getItem(cacheKey);
    if (cached) return JSON.parse(cached);

    const OVERPASS_URL = 'https://lz4.overpass-api.de/api/interpreter';
    const data = await fetchWithTimeout(`${OVERPASS_URL}?data=${encodeURIComponent(query)}`, 90000);

    sessionStorage.setItem(cacheKey, JSON.stringify(data));
    setTimeout(() => sessionStorage.removeItem(cacheKey), 5*60*1000);

    return data;
}

// ajout de markers sur la carte
function addMarker(lat, lon, name, address, stars=0) {
    const starsDisplay = stars>0 ? '⭐'.repeat(stars) : '';
    if (typeof window.mapFull === 'undefined') return;
    L.marker([lat, lon]).addTo(window.mapFull).bindPopup(`<b>${name}</b> ${starsDisplay}<br>${address}`);
}

// focus sur un partenaire au clic
function focusPartner(el) {
    const lat = parseFloat(el.dataset.lat);
    const lon = parseFloat(el.dataset.lon);
    if (!window.mapFull) return;
    window.mapFull.setView([lat, lon], 15);
    window.mapFull.eachLayer(layer => {
        if (layer instanceof L.Marker) {
            const pos = layer.getLatLng();
            if (Math.abs(pos.lat-lat)<0.0001 && Math.abs(pos.lng-lon)<0.0001) layer.openPopup();
        }
    });
}

// filtrage par distance
function filterByDistance(min, max) {
    const items = document.querySelectorAll('.partner-item');
    let visibleCount = 0;

    items.forEach(item => {
        const distance = parseFloat(item.dataset.distance);
        const inRange = min==='all'?true:(distance>=min && distance<=max);
        const show = inRange && visibleCount<5;
        item.style.display = show?'':'none';
        if(show) item.querySelector('.item-index').textContent=++visibleCount;
    });

    document.getElementById('no-results').classList.toggle('hidden', visibleCount>0);

    document.querySelectorAll('.filter-btn').forEach(btn=>{
        btn.classList.remove('bg-black/20','border-black/30','text-black');
        btn.classList.add('bg-black/5','border-black/10','text-black/60');
    });
    const activeId = min==='all'?'filter-all':`filter-${min}-${max}`;
    const activeBtn = document.getElementById(activeId);
    if(activeBtn){
        activeBtn.classList.add('bg-black/20','border-black/30','text-black');
        activeBtn.classList.remove('bg-black/5','border-black/10','text-black/60');
    }
}

// affichage des partenaires
function renderPartners(partners){
    const list = document.getElementById('partners-list');
    list.innerHTML='';
    partners.forEach((el,i)=>{
        const name = el.tags?.name || 'Établissement sans nom';
        const address = [el.tags?.['addr:housenumber'],el.tags?.['addr:street'],el.tags?.['addr:city']].filter(Boolean).join(' ')||'Adresse non renseignée';
        const phone = el.tags?.phone || el.tags?.['contact:phone']||null;
        const website = el.tags?.website||el.tags?.['contact:website']||null;
        const stars = el.stars || 0;
        const starsDisplay = stars>0?`<span class="text-yellow-500 text-xs ml-2">${'★'.repeat(stars)}${'☆'.repeat(5-stars)}</span>`:'';

        const li = document.createElement('li');
        li.className='partner-item group flex items-start gap-6 transition-colors duration-300 rounded-xl px-6 py-5 backdrop-blur-sm border border-black/10 cursor-pointer';
        li.style.backgroundColor='#E8E8E8';
        li.dataset.distance=el.dist;
        li.dataset.lat=el.lat;
        li.dataset.lon=el.lon;
        li.onmouseover=()=>li.style.backgroundColor='#D4D4D4';
        li.onmouseout=()=>li.style.backgroundColor='#E8E8E8';
        li.onclick=()=>focusPartner(li);

        li.innerHTML=`
            <div class="text-4xl text-black/20 font-bold w-10 text-right shrink-0 select-none pt-1 item-index">${i+1}</div>
            <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-4 flex-wrap">
                    <div>
                        <h2 class="text-black uppercase tracking-widest text-sm font-bold mb-1">${name}${starsDisplay}</h2>
                        <p class="text-black/50 text-xs tracking-wider uppercase flex items-center gap-1">
                            <img src="/assets/img/icons/location.svg" alt="" class="invert size-3 opacity-50">${address}
                        </p>
                    </div>
                </div>
                ${phone?`<p class="mt-2 text-black/30 text-xs tracking-wider">📞 ${phone}</p>`:''}
                ${website?`<a href="${website}" target="_blank" onclick="event.stopPropagation()" class="inline-block mt-3 text-[10px] tracking-[0.3em] uppercase text-black/60 hover:text-black transition-colors duration-300">Voir le site →</a>`:''}
            </div>
        `;
        list.appendChild(li);

        if(window.mapFullReady) addMarker(el.lat,el.lon,name,address,stars);
        else document.addEventListener('mapReady',()=>addMarker(el.lat,el.lon,name,address,stars));
    });
}

// récupération des partenaires depuis Overpass
async function loadPartners(){
    if(!USER_LAT || !USER_LON || !OSM_KEY || !OSM_VAL) return;

    const query=`
[out:json][timeout:10];
(
  node["${OSM_KEY}"="${OSM_VAL}"](around:5000,${USER_LAT},${USER_LON});
  way["${OSM_KEY}"="${OSM_VAL}"](around:5000,${USER_LAT},${USER_LON});
  relation["${OSM_KEY}"="${OSM_VAL}"](around:5000,${USER_LAT},${USER_LON});
);
out center 5;
`;

    try {
        const data = await fetchOverpassCached(query);
        document.getElementById('loading').classList.add('hidden');

        const elements = data.elements || [];
        if (!elements.length) {
            document.getElementById('no-results').classList.remove('hidden');
            return;
        }

        const withDist = elements.map(el=>{
            const lat = el.lat ?? el.center?.lat;
            const lon = el.lon ?? el.center?.lon;
            const dist = (lat&&lon)?haversine(USER_LAT,USER_LON,lat,lon):99999;
            const stars = parseInt(el.tags?.michelin_stars)||0;
            return {...el,lat,lon,dist,stars};
        }).filter(el=>el.lat && el.lon)
          .sort((a,b)=>b.stars-a.stars||a.dist-b.dist);

        renderPartners(withDist.slice(0,5));

    } catch(e) {
        console.error('Erreur Overpass:', e);
        document.getElementById('loading').textContent='Service temporairement indisponible, réessayez.';
    }
}

loadPartners();
</script>

{% endblock %}
{% block map_markers %}{% endblock %}