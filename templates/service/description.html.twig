{% extends 'base.html.twig' %}

{% block title %}Service - {{ service.name|capitalize }}{% endblock %}

{% block body %}
<div class="min-h-screen pt-52 pb-20 px-6 max-w-4xl mx-auto">

    <div class="mb-12 text-center">
        <p class="text-xs tracking-[0.4em] text-white/40 uppercase mb-2">Nos services</p>
        <h1 class="text-6xl uppercase tracking-widest text-white drop-shadow-[0_1px_1px_black] mb-4">
            {{ service.name|capitalize }}
        </h1>
        <div class="h-px w-32 mx-auto bg-gradient-to-r from-transparent via-white/40 to-transparent"></div>
    </div>

    <div class="bg-black/40 backdrop-blur-sm border border-white/10 rounded-xl px-10 py-10 text-center max-w-2xl mx-auto">
        <p class="text-white/60 text-sm leading-relaxed tracking-wide mb-10">
            {{ service.description }}
        </p>

        <div class="h-px w-24 mx-auto bg-gradient-to-r from-transparent via-white/20 to-transparent mb-10"></div>

        <p class="text-white/30 text-xs tracking-[0.3em] uppercase mb-6">
            Accédez à nos partenaires en vous connectant
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="{{ path('app_login') }}"
                class="px-8 py-3 bg-white/10 hover:bg-white/20 transition-colors duration-300 rounded-lg text-white text-xs tracking-[0.3em] uppercase border border-white/20">
                Accès membre
            </a>
            <a href="{{ path('app_register') }}"
                class="px-8 py-3 bg-white/5 hover:bg-white/10 transition-colors duration-300 rounded-lg text-white/60 text-xs tracking-[0.3em] uppercase border border-white/10">
                Devenir membre
            </a>
        </div>
    </div>

</div>
{% endblock %}