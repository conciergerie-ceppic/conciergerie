{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
	<div class="bg-black min-h-screen text-white flex items-center justify-center px-4">
		<form method="post" class="flex flex-col w-full max-w-md p-8 bg-gray-900 rounded-lg shadow-lg space-y-4">
			{% if error %}
				<div class="alert alert-danger bg-red-600 text-white p-2 rounded">
					{{ error.messageKey|trans(error.messageData, 'security') }}
				</div>
			{% endif %}

			<h1 class="text-2xl font-bold text-center mb-4">Please sign in</h1>

			<label for="username">Email</label>
			<input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control bg-black text-white border border-gray-600 focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50 p-2 rounded" autocomplete="email" required autofocus>

			<label for="password">Password</label>
			<input type="password" name="_password" id="password" class="form-control bg-black text-white border border-gray-600 focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50 p-2 rounded" autocomplete="current-password" required>

			<input
			type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

			

			{#
			    Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
			    See https://symfony.com/doc/current/security/remember_me.html
			
			    <div class="checkbox mb-3">
			        <input type="checkbox" name="_remember_me" id="_remember_me">
			        <label for="_remember_me">Remember me</label>
			    </div>
			#}
			<button class="bg-yellow-500 hover:bg-yellow-600 text-white py-2 px-4 rounded font-medium mt-2" type="submit">
				Sign in
			</button>
		</form>
	</div>
{% endblock %}
