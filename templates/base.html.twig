<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>
    <link rel="icon"
        href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
    <script src="https://cdn.tailwindcss.com"></script>
    {% block stylesheets %}
    {% endblock %}
    <link href="https://fonts.googleapis.com/css2?family=Advent+Pro:wght@400;700&display=swap" rel="stylesheet">

    {% block javascripts %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>

<body style="font-family: 'Advent Pro', sans-serif;" class="text-xl select-none w-full">

    <nav
        class="flex flex-col items-center w-full fixed text-white drop-shadow-[0_1px_1px_black] bg-black/10 rounded-b-xl z-50">
        <div class="pt-5 cursor-pointer flex items-center text-5xl">
            <img src="/assets/img/logo.png" alt="" width="50px">
            <span class="tracking-wider uppercase lg:text-xl">premium experience</span>
        </div>
        <ul class="flex space-x-20 py-8 [&_a:hover]:text-white/70 [&_a]:cursor-pointer text-4xl lg:text-2xl">
            <li><a href="#infos">Qui sommes-nous ?</a></li>
            <li>
                <div class="relative group inline-block">

                    <a href="#services" class="cursor-pointer">
                        Services
                    </a>

                    <div class="absolute p-6 
                bg-slate-500/35 rounded shadow-lg
                opacity-0 
                group-hover:opacity-100 
                transition duration-200">

                        <ul class="[&_li]:cursor-pointer [&_li:hover]:text-white/70 space-y-2">
                            <li>Hôtel</li>
                            <li>Restauration</li>
                            <li>Spa</li>
                            <li>Chauffeur</li>
                            <li>Evenements</li>
                            <li>Voyage</li>
                        </ul>

                    </div>

                </div>
            </li>
            <li><a href="#contact">Contact</a></li>
            <li>
                <div class="relative group inline-block">
                    <a href="{{path('app_member')}}" class="cursor-pointer">Devenir membre</a>
                    <div class="absolute p-6 
                bg-slate-500/35 rounded shadow-lg
                opacity-0 
                group-hover:opacity-100 
                transition duration-200">

                        <ul class="[&_li]:cursor-pointer [&_li:hover]:text-white/70 space-y-2">
                            <li>Membre</li>
                            <li>Partenaire</li>    
                </div>
            </li>
            <li><a href="{{path('app_login')}}">Accès membre</a></li>
            {# <li><a href="{{path('app_login')}}">Accès membre</a></li> #}
        </ul>
    </nav>
    <main class="w-full">


        {% block body %}
        {# Home #}
        {% endblock %}
    </main>
    <footer class="py-5 lg:h-50 bg-black/80">
        <p class="text-white text-center text-2xl lg:text-lg py-4">&copy; Ceppic 2026 | Sebastien, Kevin, Benjamin</p>
    </footer>
</body>

</html>