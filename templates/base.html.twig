<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>
    <link rel="icon"
        href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Advent+Pro:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

    {% block stylesheets %}
    {% endblock %}
    {% block javascripts %}
    {% endblock %}
</head>

<body style="font-family: 'Advent Pro', sans-serif;" class="select-none">

    {% set userLat = app.session.get('lat') %}
    {% set userLon = app.session.get('lon') %}

    {% if userLat and userLon %}
        <div id="map" class="hidden lg:flex h-[20rem] w-[20rem] fixed rounded-md bottom-0 right-0 mr-5 mb-20 opacity-90 z-50"></div>

        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const lat = {{ userLat }};
                const lon = {{ userLon }};
                const ville = "{{ app.session.get('ville')|e('js') }}";

                const map = L.map('map').setView([lat, lon], 13);

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; OpenStreetMap contributors',
                    maxZoom: 19
                }).addTo(map);

                L.marker([lat, lon]).addTo(map)
                    .bindPopup(ville ? ville : 'Vous êtes ici')
                    .openPopup();
            });
        </script>
    {% endif %}

    <nav class="flex flex-col items-center w-full fixed text-white text-4xl md:text-3xl lg:text-2xl drop-shadow-[0_1px_1px_black] bg-black/10 rounded-b-xl z-50">

        <div class="p-5 cursor-pointer flex items-center" onclick="window.location.href=`{{ path('app_home') }}`">
            <img src="/assets/img/logo.png" alt="" width="50px">
            <span class="tracking-wider uppercase">premium experience</span>
        </div>

        <ul class="hidden lg:flex items-center space-x-10 pb-5 [&_a:hover]:text-white/70 [&_a]:cursor-pointer text-xl">

            <li class="flex items-center">
                <img src="/assets/img/icons/location.svg" alt="" class="invert size-5">
                <span class="pl-1 text-sm">{{ app.session.get('ville')|default('Inconnu') }}</span>
            </li>

            <li><a class="px-4 py-2 hover:text-white/70" href="#infos">Qui sommes-nous ?</a></li>

            <li class="relative group">
                <a class="px-4 py-2 hover:text-white/70" href="#services">Services</a>

                <div class="absolute left-0 top-full
                            hidden group-hover:block
                            z-50
                            min-w-[180px]
                            p-6 bg-slate-500/95 rounded shadow-lg">
                    <ul class="space-y-2">
                        <li><a class="block hover:text-white/70" href="{{ path('app_service', {'nom': 'hotel'}) }}">Hôtel</a></li>
                        <li><a class="block hover:text-white/70" href="{{ path('app_service', {'nom': 'restaurant'}) }}">Restauration</a></li>
                        <li><a class="block hover:text-white/70" href="{{ path('app_service', {'nom': 'spa'}) }}">Spa</a></li>
                        <li><a class="block hover:text-white/70" href="{{ path('app_service', {'nom': 'driver'}) }}">Chauffeur</a></li>
                        <li><a class="block hover:text-white/70" href="{{ path('app_service', {'nom': 'event'}) }}">Evenement</a></li>
                        <li><a class="block hover:text-white/70" href="{{ path('app_service', {'nom': 'travel'}) }}">Voyage</a></li>
                    </ul>
                </div>
            </li>

            <li><a class="px-4 py-2 hover:text-white/70" href="#contact">Contact</a></li>

            {% if app.user %}
                <li><a class="px-4 py-2 hover:text-white/70" href="{{ path('app_logout') }}">Déconnexion</a></li>
            {% else %}
                <li><a class="px-4 py-2 hover:text-white/70" href="{{ path('app_register') }}">Devenir membre</a></li>
                <li><a class="px-4 py-2 hover:text-white/70" href="{{ path('app_login') }}">Accès membre</a></li>
            {% endif %}

        </ul>
    </nav>

    <main class="w-full flex-1">
        {% block body %}
        {# Home #}
        {% endblock %}
    </main>

    <footer class="py-5 lg:h-50 bg-black/80 mt-auto w-full">
        <p class="text-white text-center text-xl lg:text-lg py-4">&copy; Ceppic 2026 | Sebastien, Kevin, Benjamin</p>
    </footer>

</body>

</html>