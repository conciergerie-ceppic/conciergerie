<!DOCTYPE html>
<html>

<head>
	<meta charset="UTF-8">
	<title>
		{% block title %}Welcome!
		{% endblock %}
	</title>
	<link rel="icon"
		href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
	<script src="https://cdn.tailwindcss.com"></script>
	{% block stylesheets %}{% endblock %}
	<link href="https://fonts.googleapis.com/css2?family=Advent+Pro:wght@400;700&display=swap" rel="stylesheet">

	{% block javascripts %}
	{# {% block importmap %}{{ importmap('app') }}{% endblock %} #}{% endblock %}
</head>

<body style="font-family: 'Advent Pro', sans-serif;" class="text-xl select-none w-full min-h-screen flex flex-col">

	<nav
		class="flex flex-col items-center w-full fixed text-white drop-shadow-[0_1px_1px_black] bg-black/10 rounded-b-xl z-50">

		<div class="pt-5 cursor-pointer flex items-center text-5xl"
			onclick="window.location.href=`{{ path('app_home')}}`">
			<img src="/assets/img/logo.png" alt="" width="50px">
			<span class="tracking-wider uppercase lg:text-xl">premium experience</span>
		</div>

		<ul class="flex items-center space-x-20 py-8 text-4xl lg:text-2xl">

			<li>
				<a class="px-4 py-2 hover:text-white/70" href="#infos">
					Qui sommes-nous ?
				</a>
			</li>

			<li class="relative group">
				<a class="px-4 py-2 hover:text-white/70" href="#services">
					Services
				</a>

				<div class="absolute left-0 top-full
				hidden group-hover:block
				z-50
				min-w-[180px]
				p-6 bg-slate-500/95 rounded shadow-lg">

					<ul class="space-y-2 text-lg">
						<li>
							<a class="block hover:text-white/70"
								href="{{ path('app_service', {'nom': 'hotel'}) }}">Hôtel</a>
						</li>
						<li>
							<a class="block hover:text-white/70"
								href="{{ path('app_service', {'nom': 'restaurant'}) }}">Restauration</a>
						</li>
						<li>
							<a class="block hover:text-white/70"
								href="{{ path('app_service', {'nom': 'spa'}) }}">Spa</a>
						</li>
						<li>
							<a class="block hover:text-white/70"
								href="{{ path('app_service', {'nom': 'driver'}) }}">Chauffeur</a>
						</li>
						<li>
							<a class="block hover:text-white/70"
								href="{{ path('app_service', {'nom': 'event'}) }}">Evenement</a>
						</li>
						<li>
							<a class="block hover:text-white/70"
								href="{{ path('app_service', {'nom': 'travel'}) }}">Voyage</a>
						</li>
					</ul>

				</div>
			</li>

			<li>
				<a class="px-4 py-2 hover:text-white/70" href="#contact">
					Contact
				</a>
			</li>

			<li>
				<a class="px-4 py-2 hover:text-white/70" href="{{path('app_register')}}">
					Devenir membre
				</a>
			</li>

			<li>
				<a class="px-4 py-2 hover:text-white/70" href="{{path('app_login')}}">
					Accès membre
				</a>
			</li>
			{% if app.user %}
			<div class="inline-flex items-center space-x-3 rounded">
				<div class="relative group">
					<img class="size-12 rounded-full" src="/assets/img/uploads/avatars/{{app.user.avatar}}" alt="">
					<div class="absolute size-5 left-0 top-full
				hidden group-hover:block
				z-50
				min-w-[180px]
				p-6 bg-slate-500/95 rounded shadow-lg">
						<form method="post" encType="multipart/form-data" action="{{ path('upload_avatar') }}">
							<input type="file" name="avatar">
							<button type="submit" class="">
								Valider l'avatar
							</button>
						</form>
					</div>
				</div>
				<form method="post" action="{{ logout_path() }}">
					<button type="submit" class="px-3 py-1 bg-black hover:bg-yellow-500 text-white rounded font-medium">
						Logout
					</button>
				</form>
			</div>
			{% endif %}
</body>

</html>
</body>

</html>
</ul>
</nav>
<main class="w-full flex-1">{% block body %}
	{# Home #}{% endblock %}</main>
<footer class="py-5 lg:h-50 bg-black/80 mt-auto w-full">
	<p class="text-white text-center text-2xl lg:text-lg py-4">&copy; Ceppic 2026 | Sebastien, Kevin, Benjamin</p>
</footer>
</body>

</html>